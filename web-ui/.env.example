# Dev-server proxy target (the running C++ Crow server). Used only by `vite dev`.
# Default is http://localhost:8000. Point it at the Jetson to develop against
# the real device:
#   VITE_CROW=http://192.168.0.42:8000
VITE_CROW=http://localhost:8000

# Optional build-time backend origin baked into the bundle. Leave empty for the
# Crow-served / dev-proxy case (same-origin). Set to an absolute origin when the
# frontend is hosted apart from the backend (e.g. a future Tauri/Wails desktop
# build talking to a remote Jetson):
#   VITE_API_BASE=http://192.168.0.42:8000
# (Can also be overridden at runtime via localStorage['fitra.apiBase'].)
VITE_API_BASE=
