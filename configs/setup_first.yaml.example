# First-run bootstrap template for the WebUI-driven setup flow.
# See docs/design/core-pipeline-setup-mode.md.
#
#   ./cpp/build/main --daemon --config configs/session.yaml
#
# Point --config at a writable runtime config (e.g. configs/session.yaml, which
# is gitignored). If that file does not exist yet, the daemon seeds it from this
# template automatically. The Setup module writes the composed config back to
# that path — it refuses to overwrite a .example template, so this file stays a
# clean checked-in seed.
#
# With no cameras configured, the daemon's initial mode is `setup`: it spawns
# the GPU-less Setup module which serves the WebUI on :8000. Open the browser,
# pick cameras + engines + output targets, and the Setup module writes the full
# config and hands off to the rest of the chain (intrinsic -> extrinsic ->
# subject -> run).

schema: fitra_main_config_v1

# No cameras yet — this is exactly what makes the daemon land in setup mode.
# The Setup module fills cameras + inference.det_engine/pose_engine in.

web:
    port: 8000

# Optional always-on source-corpus collection for pose-model audition and later
# temporal-model training. Enabling this keeps full inference running even when
# the normal consumer-idle gate would enter standby. The SSD spool never deletes
# unverified data merely to make room. For a mounted NAS target, create the
# marker while it is mounted (`touch /mnt/nas/fitra-corpus/.fitra-corpus-target`)
# so an unmounted empty directory is never filled accidentally.
#corpus:
#    enabled: true
#    spool_dir: outputs/pose-corpus
#    remote_dir: /mnt/nas/fitra-corpus
#    pre_roll_s: 5
#    post_roll_s: 10
#    segment_s: 5
#    upload_absent_s: 30
#    presence_stale_s: 2
#    queue_max_mib: 128
#    ring_max_mib: 512
#    spool_max_gib: 256
#    min_free_gib: 10
#    remove_after_upload: true

# Run the intrinsic calibration step (step 0) once cameras are configured. Its
# output is a GENERATED artifact written to calibrations/intrinsics/latest.yaml
# (a timestamped <date>.yaml history + a `latest` symlink). Set false only if you
# supply intrinsics another way.
intrinsic_calib:
    enabled: true

# Calibration files are GENERATED outputs — you do NOT set their paths here.
# The extrinsic solve writes calibrations/extrinsics/<timestamp>.yaml and repoints
# calibrations/extrinsics/latest.yaml; run resolves that latest automatically and,
# when it is missing, routes to calibration (no "--calib required" error). Pin an
# explicit file (extrinsic_calib.out + three_d.calib, kept equal) only for a fixed
# external calibration. See docs/design/pose-3d-calib-latest-resolution.md.
extrinsic_calib:
    method: controller          # controller | floor

# Subject identity lives here (one place). subject_id + subject_height_m drive
# BOTH run (which profile to load) and subject calibration (which subject to
# calibrate). The subject-calib stage runs when subject_id is set AND no profile
# exists yet under subjects_dir/<id>/ — use a fresh id to (re)calibrate, or
# delete that profile. Leave subject_id empty to skip subject calibration.
#subject:
#    subject_id: subject01
#    subject_height_m: 1.70
# Optional subject-calibration process tuning (parallels intrinsic_calib /
# extrinsic_calib). No subject id/height here — those live in `subject:` above.
#subject_calib:
#    frames_per_cam: 75
#    hold_sec: 1.5
#    auto_approve: false
#    auto_exit: false
