# 2-camera 3D live config for cpp/build/main.
#
# Copy this file to `configs/live_2cam_3d.yaml` (gitignored) and edit the
# device / engine paths for your machine, then run with
# `--config configs/live_2cam_3d.yaml`.
#
# Equivalent CLI:
#   ./cpp/build/main \
#       --cam0 /dev/v4l/by-path/usb-cam-A-video-index0 \
#       --cam1 /dev/v4l/by-path/usb-cam-B-video-index0 \
#       --det-engine outputs/tensorrt_engines/yolox_tiny.fp16.engine \
#       --pose-engine outputs/tensorrt_engines/rtmpose_m_halpe26.fp16.engine \
#       --keypoint-format halpe26 \
#       --enable-3d \
#       --calib calibrations/measure_session/cam_params.yaml \
#       --port 8000
#
# To run a previously calibrated subject's IK profile, fill in `subject.subject_id`.
# To attach the SlimeVR Firmware UDP publisher, uncomment the slimevr block and
# point `host` at your SlimeVR Server machine.

schema: fitra_main_config_v1

cameras:
  cam0: /dev/v4l/by-path/usb-cam-A-video-index0
  cam1: /dev/v4l/by-path/usb-cam-B-video-index0
  # Decode/preprocess path. On Jetson, `nvjpeg` runs the full GPU front-end
  # (HW NVJPEG decode + EGL->CUDA + GPU YOLOX/RTMPose preprocess, no host
  # round-trip). Subject-in-view measurement: photon->VR-send e2e 34->26ms vs
  # the default `mjpeg` (CPU). `yuyv` is uncompressed (no decode, more USB BW).
  # Equivalent CLI: --pixel-format {mjpeg|yuyv|nvjpeg}.
  pixel_format: nvjpeg

inference:
  det_engine: outputs/tensorrt_engines/yolox_tiny.fp16.engine
  pose_engine: outputs/tensorrt_engines/rtmpose_m_halpe26.fp16.engine
  keypoint_format: halpe26

three_d:
  enable_3d: true
  # calib = 外部校正の出力（生成物）。空欄のまま（既定）で
  # calibrations/extrinsics/latest.yaml を自動解決（無ければ校正へ routing）。
  # 固定したい既存ファイルがあれば明示する（生成物の既定パスは焼かない）。
  # calib: calibrations/extrinsics/some_fixed_extrinsics.yaml
  # 接地足の ankle + toe/heel を床面へ安定化（既定 ON、Halpe26 のみ）。
  # controller-marker 等で床が Z=0 でない場合だけ floor_z_m を実測値へ変更する。
  # floor_contact_stability: true
  # floor_z_m: 0.0
  # 実機チューニングが必要な場合のみ以下を変更する。
  # floor_contact_enter_height_m: 0.03
  # floor_contact_exit_height_m: 0.06
  # floor_contact_enter_speed_mps: 0.25
  # floor_contact_exit_speed_mps: 0.80
  # floor_contact_xy_tau_s: 0.25
  # floor_contact_max_xy_correction_m: 0.03
  # floor_contact_max_z_correction_m: 0.08
  # floor_contact_missing_grace_frames: 2
  # floor_contact_reset_gap_s: 0.50
  # floor_contact_release_tau_s: 0.05

subject:
  subjects_dir: calibrations/subjects
  # subject_id: subject01

web:
  port: 8000

# slimevr:
#   slimevr_out: true
#   host: 192.168.1.100   # IP of your Windows SlimeVR Server
#   port: 6969
#   rate_hz: 60.0
#   preview_no_reset: true # make SlimeVR GUI skeleton preview usable before reset

# vmt:
#   vmt_out: true
#   host: 192.168.1.100    # IP of the Windows machine running VMT Manager
#   port: 39570
#   rate_hz: 60.0
#   index_base: 10         # publishes VMT_10..VMT_19; avoids common VMT_0..2 HMD/hand overrides
#   pos_smooth: 0.5
#   degeneracy_mode: hold
